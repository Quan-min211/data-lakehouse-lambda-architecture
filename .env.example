# =============================================================================
# Data Lakehouse Lambda Architecture — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before running docker compose.

# --- MinIO (S3-compatible Object Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# --- Apache Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW_EVENTS=raw-events

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=lakehouse

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# --- Iceberg REST Catalog ---
ICEBERG_CATALOG_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3://warehouse/

# --- Dagster ---
DAGSTER_HOME=/opt/dagster/dagster_home

# --- FastAPI Serving ---
SERVING_API_HOST=0.0.0.0
SERVING_API_PORT=8000
