FROM python:3.10-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    streamlit==1.30.0 \
    plotly==5.18.0 \
    requests==2.31.0 \
    clickhouse-connect==0.7.0 \
    redis==5.0.0 \
    python-dotenv==1.0.0

COPY dashboard/ ./dashboard/

EXPOSE 8501

CMD ["streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
