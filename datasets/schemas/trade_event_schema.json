{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CryptoTradeEvent",
  "description": "Schema chuan hoa cho su kien giao dich tien ma hoa (Normalized Binance Trade Event). Cac rang buoc khop voi Data Quality Gate trong src/data_quality/dq_checks.py.",
  "type": "object",
  "properties": {
    "trade_id": {
      "type": "integer",
      "minimum": 0
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z0-9]+$"
    },
    "price": {
      "type": "number",
      "minimum": 1e-8
    },
    "quantity": {
      "type": "number",
      "minimum": 1e-8
    },
    "trade_time": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "is_buyer_maker": {
      "type": "boolean"
    },
    "ingestion_time": {
      "type": "integer",
      "minimum": 0
    },
    "is_injected": {
      "type": "boolean",
      "default": false
    },
    "fault_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "duplicate",
        "late_data",
        "out_of_order",
        "schema_invalid",
        "negative_price",
        null
      ]
    }
  },
  "required": [
    "trade_id",
    "symbol",
    "price",
    "quantity",
    "trade_time",
    "is_buyer_maker",
    "ingestion_time",
    "is_injected"
  ]
}
